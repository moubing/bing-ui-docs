{
  "name": "bing-ui-docs",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm docs:check && nuxt build",
    "dev": "nuxt dev",
    "generate": "pnpm docs:check && nuxt generate",
    "preview": "nuxt preview",
    "test:docs": "playwright test",
    "docs:export": "node scripts/export-ai-docs.ts",
    "docs:check": "node scripts/export-ai-docs.ts --check",
    "docs:check-release": "node scripts/check-release.ts",
    "docs:check-https": "node scripts/check-https-entry.ts",
    "test:docs-export": "node --test tests/docs/*.test.ts",
    "typecheck:docs": "tsc -p tsconfig.docs.json",
    "typecheck:ai-examples": "node scripts/check-ai-examples.ts",
    "test:ai-examples": "playwright test -c playwright.ai-docs.config.ts",
    "typecheck": "nuxt typecheck",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@comark/nuxt": "0.6.2",
    "@moubing/bing-ui": "0.19.0",
    "comark": "0.6.2",
    "gsap": "^3.15.0",
    "lucide-vue-next": "1.0.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.12.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/compiler-sfc": "3.5.39",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.2"
  }
}

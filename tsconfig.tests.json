{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["playwright*.config.ts", "tests/browser/**/*.ts", "tests/ai-browser/**/*.ts", "tests/fixtures/ai-docs/*.ts"]
}
